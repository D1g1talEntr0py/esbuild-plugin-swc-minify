{
  "name": "esbuild-plugin-swc-minify",
  "author": "D1g1talEntr0py",
  "version": "2.2.0",
  "license": "MIT",
  "description": "esbuild plugin to minify JS(X) files using SWC",
  "homepage": "https://github.com/D1g1talEntr0py/esbuild-plugin-swc-minify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D1g1talEntr0py/esbuild-plugin-swc-minify.git"
  },
  "bugs": {
    "url": "https://github.com/D1g1talEntr0py/esbuild-plugin-swc-minify/issues"
  },
  "maintainers": [
    {
      "name": "D1g1talEntr0py",
      "email": "jason.dimeo@gmail.com"
    }
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esbuild-plugin-swc-minify.d.ts",
      "import": "./dist/esbuild-plugin-swc-minify.js"
    }
  },
  "files": [
    "./dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint --flag unstable_native_nodejs_ts_config ./src",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublish": "pnpm lint && pnpm -s build"
  },
  "dependencies": {
    "@swc/types": "^0.1.28"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "globals": "^17.14.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "@swc/core": ">=1.13.3",
    "esbuild": ">=0.20.0"
  },
  "keywords": [
    "esbuild",
    "plugin",
    "swc",
    "minify"
  ]
}
